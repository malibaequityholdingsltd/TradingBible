{
  "name": "TradingBible — AI Trading Journal & Terminal",
  "short_name": "TradingBible",
  "description": "The AI-powered trading journal built on a Bloomberg-grade terminal.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0a0a0f",
  "theme_color": "#0a0a0f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "productivity", "business"],
  "icons": [
    {
      "src": "/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Your live performance terminal",
      "url": "/app"
    },
    {
      "name": "Journal",
      "short_name": "Journal",
      "description": "Trade journal",
      "url": "/app/journal"
    },
    {
      "name": "AI Coach",
      "short_name": "Coach",
      "description": "Ask your AI trading coach",
      "url": "/app/coach"
    },
    {
      "name": "Charts",
      "short_name": "Charts",
      "description": "Live charts and analysis",
      "url": "/app/charts"
    }
  ],
  "share_target": {
    "action": "/app/journal",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
