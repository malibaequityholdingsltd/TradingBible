# Runtime execution register (recipient emails, envelope IDs, approval notes)
.execution/

# The five public summaries below are versioned with the code.
# The 26 corporate and governance instruments contain confidential issuer
# information (tax identifiers, registered office, signature blocks), so they
# must be provisioned server-side and never committed to the public repository.

pdf/*.pdf
!pdf/tbc-whitepaper.pdf
!pdf/tbc-supply-allocation-vesting.pdf
!pdf/tbc-purchases-payments-custody-refunds.pdf
!pdf/tbc-jurisdictions-purchaser-eligibility.pdf
!pdf/tbc-brokerage-platform-separation.pdf

docx/*.docx
!docx/tbc-whitepaper.docx
!docx/tbc-supply-allocation-vesting.docx
!docx/tbc-purchases-payments-custody-refunds.docx
!docx/tbc-jurisdictions-purchaser-eligibility.docx
!docx/tbc-brokerage-platform-separation.docx

# Read-only download copies. Public summaries are versioned; controlled
# instruments remain server-side only.
docx-protected/*.docx
!docx-protected/tbc-whitepaper.docx
!docx-protected/tbc-supply-allocation-vesting.docx
!docx-protected/tbc-purchases-payments-custody-refunds.docx
!docx-protected/tbc-jurisdictions-purchaser-eligibility.docx
!docx-protected/tbc-brokerage-platform-separation.docx
