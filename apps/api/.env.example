# TradingBible API — environment variables
# Copy to apps/api/.env and fill in real values. Never commit the real .env.

# Server
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://tradingbible.app

# Market data providers
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=

# Supabase (primary auth/data layer)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SEND_EMAIL_HOOK_SECRET=

# SMTP for Supabase auth email hook
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=TradingBible
SMTP_FROM_EMAIL=

# Integrated AI proxy
INTEGRATED_AI_API_URL=
INTEGRATED_AI_API_KEY=
WEBSITE_ID=
WEBSITE_DOMAIN=tradingbible.app
PROXY_ENTRANCE_ID=

# OpenAI-compatible chat fallback (DeepSeek / OpenAI / Groq / any /chat/completions provider)
# Used when the Integrated AI proxy is not configured.
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# API docs key (client-side example key shown in ApiDocsPage)
TB_API_KEY=

# Billing (Paddle)
PADDLE_ENV_OVERRIDE=live
PADDLE_LIVE_API_KEY=
PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_LIVE_WEBHOOK_SECRET=
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_SANDBOX_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_ELITE=
PADDLE_PRICE_PROFESSIONAL=

# Circle Agent Services (optional x402 paywall for AI stream endpoint)
CIRCLE_X402_ENABLED=false
CIRCLE_X402_SELLER_ADDRESS=
CIRCLE_X402_PRICE=$0.01
