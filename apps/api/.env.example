# TradingBible API — environment variables
# Copy to apps/api/.env and fill in real values. Never commit the real .env.

# Server
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://tradingbible.app
# Comma-separated exact admin emails. A profile role of "admin" also grants
# access. Do not use a catch-all domain rule for administrator access.
ADMIN_EMAILS=
# Require Supabase AAL2 (TOTP, passkey/WebAuthn or SSO) for admin routes.
# Leave false until every named administrator has enrolled a second factor.
ADMIN_MFA_REQUIRED=false
# Comma-separated additional origins if needed. Do not use a wildcard with credentials.
CORS_ORIGINS=
# Number of trusted reverse-proxy hops. Production uses one local Nginx hop.
# Set 0/false if the Node process is directly exposed; do not trust arbitrary XFF.
TRUST_PROXY=1
# Set false only when Nginx is the sole owner of the HSTS header.
HELMET_HSTS=true

# Market data providers
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=

# Supabase (primary auth/data layer)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required in production. Must match the Send Email hook secret in the
# Supabase dashboard (Auth → Hooks → Send Email). Production refuses unsigned
# requests when this is empty. Prefix with whsec_ and keep both sides in sync.
SEND_EMAIL_HOOK_SECRET=

# SMTP for Supabase auth email hook
# Hostinger mailbox: use SSL on 465 (587 also works with STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@tradingbible.app
SMTP_PASS=
SMTP_FROM_NAME=TradingBible
SMTP_FROM_EMAIL=support@tradingbible.app

# Company communications
# Required before any commercial/marketing email is sent. Leave empty to keep
# marketing templates blocked while transactional previews remain available.
COMPANY_POSTAL_ADDRESS=
# Optional absolute logo URL for the email shell. Defaults to APP_URL/logos/tradingbible-logo.png.
EMAIL_LOGO_URL=

# Controlled investor letters
# A dedicated HMAC secret for unsubscribe links. Use at least 32 random
# characters. Real investor-letter sends remain blocked until this is set.
INVESTOR_LETTERS_SECRET=
# Regulation CF sending gates. Pre-launch education can be prepared with
# status=prelaunch. Campaign-live and reminder emails require qualified, a
# named FINRA-registered intermediary and the intermediary's offering URL.
REG_CF_OFFERING_STATUS=prelaunch
REG_CF_INTERMEDIARY=
REG_CF_OFFERING_URL=

# Integrated AI proxy
INTEGRATED_AI_API_URL=
INTEGRATED_AI_API_KEY=
WEBSITE_ID=
WEBSITE_DOMAIN=tradingbible.app
PROXY_ENTRANCE_ID=

# Local opencode gateway (optional; free chat-only model e.g. muse-spark-1.3-contributor-free).
# Requires `opencode serve --port 8001` running locally. Leave empty to disable.
OPENCODE_SERVER_URL=http://127.0.0.1:8001
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL=muse-spark-1.3-contributor-free
OPENCODE_PROVIDER=opencode
OPENCODE_TIMEOUT_MS=180000

# DeepSeek (OpenAI-compatible /chat/completions provider, DeepSeek V4 Flash by default)
# Official API: base https://api.deepseek.com and DEEPSEEK_API_KEY from https://platform.deepseek.com
# Free tier alternative: OpenRouter with DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1,
# DEEPSEEK_API_KEY=<OpenRouter key> and DEEPSEEK_MODEL=deepseek/deepseek-v4-flash:free
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=

# Generic OpenAI-compatible chat fallback (OpenAI / Groq / any /chat/completions provider)
# Used when neither the Integrated AI proxy nor DeepSeek is configured.
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash

# API docs key (client-side example key shown in ApiDocsPage)
TB_API_KEY=

# Billing — Stripe (primary) + Paddle fallback
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ACADEMY=
# Real-money wallet rails
# Public base URL of the web app (Connect onboarding + Identity return URLs)
APP_URL=https://tradingbible.app
# 0x aggregator API key (non-custodial swap quotes). Empty = swaps disabled.
ZEROX_API_KEY=
# Transak API key + environment (staging|production) for card-to-crypto
# on-ramp widget. Empty = on-ramp disabled.
TRANSAK_API_KEY=
TRANSAK_ENV=staging
# TradingBible Coin (TBC) — contract addresses activate tracking, swaps and
# (with treasury) payments. Empty = pre-launch display mode.
# Peg is fixed: 1 TBC = 1 KWD. USD floats via USD_PER_KWD (default 3.25).
USD_PER_KWD=3.25
TBC_CONTRACT_ETHEREUM=
TBC_CONTRACT_BASE=
TBC_CONTRACT_SOLANA=
TBC_TREASURY_ADDRESS=
# Regulated TBC surfaces are server-gated and default off. A contract
# address is not issuance; every switch below requires the corresponding
# legal, compliance, technical and security approval.
TBC_TOKEN_ISSUED=false
TBC_SALE_ENABLED=false
TBC_STAKING_ENABLED=false
TBC_GOVERNANCE_ENABLED=false
TBC_MIGRATION_ENABLED=false
TBC_CHAIN_LIVE=false
# DocuSign eSignature — controlled legal-instrument execution.
# Empty credentials keep the vault in prepare-only mode; nothing can be sent.
# JWT grant: create an integration key, grant impersonation consent, and use
# the API username (user ID) whose account owns the envelopes.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# PEM (multiline is fine) or base64-encoded PEM. Never commit this value.
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
# DocuSign Connect HMAC secret. Connect endpoint:
# https://<api-host>/api/webhooks/docusign
DOCUSIGN_CONNECT_HMAC_KEY=
# true = send immediately after preparing; false = create a draft for review.
DOCUSIGN_SEND_ON_CREATE=true
# Fundraising envelope creation/sending stays locked unless this is true.
# Set it only after board authorization and counsel review of the exact
# document version. The TBC and TB stock libraries have separate controls.
FUNDRAISING_EXECUTION_ENABLED=false
# Billing (Paddle) — legacy fallback
PADDLE_ENV_OVERRIDE=live
PADDLE_LIVE_API_KEY=
PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_LIVE_WEBHOOK_SECRET=
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_SANDBOX_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_ELITE=
PADDLE_PRICE_PROFESSIONAL=

# Dun & Bradstreet Direct+ (company DUNS verification)
# Paid Direct+ contract required for live data. Empty = sandbox stub mode.
DNB_API_BASE=https://plus.dnb.com
DNB_CLIENT_ID=
DNB_CLIENT_SECRET=

# Circle Agent Services (optional x402 paywall for AI stream endpoint)
CIRCLE_X402_ENABLED=false
CIRCLE_X402_SELLER_ADDRESS=
CIRCLE_X402_PRICE=$0.01

# Broker credential vault
# AES-256-GCM key. Generate with: openssl rand -hex 32
# Keep it out of source control and back it up separately from the ciphertext.
VAULT_ENCRYPTION_KEY=

# =============================================================================
# BROKER & PROP FIRM CREDENTIALS — Required for live account sync
# =============================================================================
# DEMO ACCOUNTS ARE BLOCKED — Only live/funded accounts can connect
# =============================================================================

# MT4/MT5 Bridge (MetaApi, Trade Copier, or custom bridge)
# Required for: MT4, MT5, MyFundedFX, True Forex Funds
MT_BRIDGE_URL=
MT_BRIDGE_TOKEN=

# cTrader Open API (Spotware)
# Register at: https://openapi.ctrader.com/apps
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# DXtrade (Devexperts)
# Obtain from your DXtrade broker
DXTRADE_API_URL=
DXTRADE_API_KEY=

# Interactive Brokers (IBKR Client Portal / Web API)
# Enable in IBKR settings, register OAuth app
IBKR_CLIENT_ID=
IBKR_CLIENT_SECRET=

# Binance API (Read-only keys sufficient for market data)
# Create at: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit API (Read-only + passphrase for enhanced security)
# Create at: https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_PASSPHRASE=

# OKX API (Passphrase REQUIRED)
# Create at: https://www.okx.com/account/my-api
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Coinbase OAuth
# Register at: https://cloud.coinbase.com/access/api
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=

# Kraken API
# Create at: https://pro.kraken.com/settings/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# KuCoin API (Passphrase REQUIRED)
# Create at: https://www.kucoin.com/account/api
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# TradingView Broker Connections
# Register at: https://www.tradingview.com/broker-connections/
TRADINGVIEW_CLIENT_ID=
TRADINGVIEW_CLIENT_SECRET=